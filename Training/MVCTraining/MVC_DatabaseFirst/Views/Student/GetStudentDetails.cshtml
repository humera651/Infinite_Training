﻿@model IEnumerable<MVC_DatabaseFirst.Models.Student>
@{
    ViewBag.Title = "GetStudentDetails";
}

<h2>GetStudentDetails</h2>

@foreach (var item in Model)
{
    <ul style="color:firebrick;">
        <li>@item.StudentRollNumber</li>
        <li>@item.StudentName</li>
        <li>@item.DOB</li>
        <li>@item.Class</li>
    </ul>
}