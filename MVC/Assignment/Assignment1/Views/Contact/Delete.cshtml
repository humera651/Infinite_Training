@model Assignment1.Models.Contact
@{
    ViewBag.Title = "Delete";
}
<style>

    h2 {
        margin-bottom: 15px;
        color: darkslategray;
    }

    p {
        margin-bottom: 20px;
        font-size: 15px;
    }

    .contact-info {
        margin-bottom: 20px;
        padding: 12px;
        background-color: aliceblue;
        border-radius: 6px;
    }

        .contact-info strong {
            font-size: 16px;
        }

        .contact-info span {
            display: block;
            margin-top: 5px;
            color: dimgray;
        }

    form {
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    button {
        padding: 8px 16px;
        background-color: crimson;
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 14px;
        cursor: pointer;
    }

        button:hover {
            background-color: darkred;
        }

    .hyperlinkcls {
        padding: 8px 16px;
        background-color: lightgray;
        color: black;
        text-decoration: none;
        border-radius: 6px;
        font-size: 14px;
    }
        .hyperlinkcls:hover {
            background-color: gray;
            color: white;
        }

</style>
<h2>Delete Contact</h2>

<p>Are you sure you want to delete this contact?</p>

<div class="contact-info">
    <strong>@Model.FirstName @Model.LastName</strong>
    <span>@Model.Email</span>
</div>

<form method="post" asp-action="DeleteConfirmed">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />

    <button type="submit">Yes, Delete</button>
    <div class="hyperlinkcls">
        <a href="@Url.Action("Index")">No, Go Back</a>
    </div>
</form>

