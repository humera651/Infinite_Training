@model IEnumerable<Week8_CodingTest.Models.Customer>
@{
    ViewBag.Title = "GetAllGermanCustomers";
}

<h2>Get All German Customers</h2>

<table>
    <tr>
        <th>Customer ID</th>
        <th>Company Name</th>
        <th>City</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.CustomerID</td>
            <td>@item.CompanyName</td>
            <td>@item.City</td>
        </tr>
    }
</table>

